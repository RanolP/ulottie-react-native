{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ulottie",
  "compatibility_date": "2026-06-05",
  "build": {
    "command": "yarn build:demo",
  },
  "route": {
    "pattern": "ulottie.cometkim.dev",
    "custom_domain": true,
  },
  "assets": {
    "directory": "./dist",
  },
}
